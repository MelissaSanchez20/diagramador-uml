DATABASE_URL=postgresql+psycopg://usuario:contraseña@localhost:5432/diagramador_uml_db
PROJECT_NAME=Diagramador UML
# Clave para firmar los JWT. Genera una aleatoria, p. ej.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esta-clave-por-una-aleatoria-larga
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# CU11 — comandos de voz (function calling). Conseguí la key en
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-tu-api-key-de-openai
OPENAI_MODEL=gpt-4o-mini
# CU12 — reconocimiento de diagramas por foto (visión). gpt-4o es bastante
# más preciso que gpt-4o-mini para esto; ~1 centavo de dólar por foto.
OPENAI_VISION_MODEL=gpt-4o
#venv\Scripts\activate
#uvicorn app.main:app --reload
